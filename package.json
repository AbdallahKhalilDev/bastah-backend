{
  "name": "bastah-backend",
  "version": "1.0.0",
  "description": "Backend API for Bastah, a Gaza marketplace for comparing shop prices",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/api.test.js",
    "seed:categories": "node seed/categories.seed.js",
    "seed:products": "node seed/products.seed.js",
    "seed:listings": "node seed/listings.seed.js",
    "seed:areas": "node seed/areas.seed.js",
    "seed:delivery-zones": "node seed/deliveryZones.seed.js",
    "set-role": "node scripts/setRole.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
