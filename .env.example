PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/bastah
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Optional (these defaults are used when left out) ---
# Wrong passwords allowed per IP + email in 15 minutes, before a 15-minute wait.
LOGIN_MAX_FAILED_ATTEMPTS=10
# All sign-up/login requests allowed per IP in 15 minutes.
AUTH_MAX_REQUESTS=100
# How many proxies sit in front of the server (Render = 1). Check: GET /api/health/ip
TRUST_PROXY_HOPS=1
